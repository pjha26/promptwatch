# Copy to .env.local only if that file does not already exist.
# Supply values from your own Supabase and Upstash projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Supabase Authentication > Users > intended owner's user UUID (server-only).
PROMPTWATCH_OWNER_ID=
# Comma-separated public path prefixes, root only by default. Never list private routes.
PROMPTWATCH_PUBLIC_PATH_PREFIXES=/
# Optional, direct Vercel hosting only. Leave disabled until official feeds are refreshed.
PROMPTWATCH_IP_VERIFICATION=disabled
# Set false on a separate dashboard when another site supplies this deployment's traffic.
PROMPTWATCH_COLLECTOR_ENABLED=true
# Enable only on the dashboard deployment after owner/services setup; never expose this secret.
PROMPTWATCH_AUTO_REFRESH_FEEDS=false
# Generate a private random base64url/hex value, 32-256 characters. Vercel supplies it as Bearer auth.
CRON_SECRET=
# Optional dashboard-only webhook delivery; off until owner/services/receiver are ready.
PROMPTWATCH_ALERTS_ENABLED=false
PROMPTWATCH_WEBHOOK_URL=
# Separate private random base64url/hex signing secret, 32-256 characters.
PROMPTWATCH_WEBHOOK_SECRET=
